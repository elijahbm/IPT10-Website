# Copy this file to ".env" and paste your own Stripe test keys.
# Get them from https://dashboard.stripe.com/test/apikeys
#
#   VITE_* values are compiled into the browser bundle. Only ever put a
#   PUBLISHABLE key (pk_...) behind a VITE_ prefix.
#
#   STRIPE_SECRET_KEY is read by server/index.js only and must never be
#   prefixed with VITE_, never committed, and never sent to the browser.

VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me

# Port for the payment server. If you change it, change it in vite.config.js too.
PORT=4242
